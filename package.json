{
  "name": "second-brain-app",
  "version": "0.1.0",
  "private": true,
  "description": "Schaltzentrale – Wissensspeicher, Projektsteuerung und Rückblicke (Single-User)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:migrations": "vitest run --project migrations",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "playwright test --config playwright.build.config.ts",
    "db:push:test": "bash scripts/db.sh push test",
    "db:push:prod": "bash scripts/db.sh push prod",
    "db:types": "bash scripts/db.sh types",
    "db:check:test": "node scripts/check-seeds.mjs test",
    "db:check:prod": "node scripts/check-seeds.mjs prod",
    "db:mfa:test": "node scripts/check-mfa.mjs test",
    "db:mfa:prod": "node scripts/check-mfa.mjs prod"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/server": "2.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "aws4fetch": "1.0.20",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "fractional-indexing": "4.0.0",
    "geist": "1.7.2",
    "heic-to": "1.6.5",
    "linkifyjs": "4.3.3",
    "lucide-react": "1.55.0",
    "mermaid": "11.17.2",
    "next": "16.4.1",
    "pdfjs-dist": "6.4.299",
