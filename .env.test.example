# Vorlage für .env.test.local – TEST, ein zweites Supabase-Projekt nur für Tests
# (nur für Integrations- und E2E-Tests). Kopieren nach .env.test.local und ausfüllen.
# Der Test-Schutzschalter (tests/guard.ts) bricht ab, wenn diese URL leer ist oder auf Prod zeigt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Session-Pooler-Connection-String des TESTPROJEKTS (siehe Hinweise in .env.example)
SUPABASE_DB_URL=

# Die zwei Testnutzer (im Dashboard angelegt, „Auto Confirm User“ muss aktiv gewesen sein)
E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

# TOTP-Geheimnisse (Base32) des zweiten Faktors der Testnutzer (B16). Nicht von Hand ausfüllen:
# `node scripts/test-totp.mjs` richtet TOTP im Testprojekt ein und schreibt sie hierher.
E2E_USER_A_TOTP_SECRET=
E2E_USER_B_TOTP_SECRET=

# Nächtliche Sicherung der Dateien (E32): S3-Zugang des Storage im TESTPROJEKT (Tests und
# Wiederherstellungs-Probe), nur hier, nie im Client.
# Dashboard → Project Settings → Storage → S3 Connection: „Endpoint“ und „Region“ abschreiben,
# „New access key“ anlegen (Name „Backup Mac“). Der Schlüssel darf alle Buckets – widerrufen geht
# dort jederzeit.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Dateien in Cloudflare R2 (E41): NUR der Test-Bucket „triskel-dateien-test“ mit eigenem Token
# „Objekt lesen & schreiben“ (Testserver, Integrationstests, Umzugs- und Restore-Probe). Der
# Schutzschalter (tests/guard.ts, readR2Config) bricht ab, wenn R2_BUCKET der Prod-Bucket ist.
R2_ACCOUNT_ID=
R2_BUCKET=triskel-dateien-test
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
