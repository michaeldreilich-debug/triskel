# Vorlage für .env.local – PROD, das eigene Supabase-Projekt (echte Daten)
# Kopieren nach .env.local und ausfüllen. .env.local nie committen, nie in Chat/Logs ausgeben.
#
# Supabase-Dashboard → Projekt → Connect (bzw. Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nur für Migrationen (supabase db push / gen types), nie im Client.
# Dashboard → Connect → „Session pooler“ (Port 5432, Host …pooler.supabase.com) – NICHT „Direct connection“
# (die ist im Gratis-Tarif nur per IPv6 erreichbar). [YOUR-PASSWORD] durch das DB-Passwort ersetzen;
# Sonderzeichen im Passwort URL-kodieren: % → %25 · @ → %40 · # → %23 · / → %2F · : → %3A · ? → %3F
# · ! → %21 · ^ → %5E (am einfachsten: Passwort nur aus Buchstaben und Ziffern)
SUPABASE_DB_URL=

# Nur für Dateien, die noch im Supabase-Storage liegen (Altbestand vor R2) – bei einer neuen
# Installation leer lassen. S3-Zugang des Storage, nur hier, nie im Client.
# Dashboard → Project Settings → Storage → S3 Connection: „Endpoint“ und „Region“ abschreiben,
# „New access key“ anlegen (Name „Backup Mac“). Der Schlüssel darf alle Buckets – widerrufen geht
# dort jederzeit.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Dateien in Cloudflare R2 (E41, docs/konzept-r2.md). Die App selbst bekommt ihre R2-Werte nur in
# Vercel (Production: R2_ACCOUNT_ID, R2_BUCKET=triskel-dateien, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY) – NICHT hier: ein lokaler `npm run dev` zeigt Dateien als „nicht verfügbar“.
# R2_EXCLUSIVE_UPLOADS=1 (R-5: Hochlade-Link nimmt nur einen PUT an) ebenfalls nur in Vercel
# (Production) und in .env.test.local – vorher CORS beider Buckets mit if-none-match (README › R2).
# Hier liegen nur die Skript-Zugänge (Konto-ID: R2-Übersicht rechts; Token: R2 › API-Tokens verwalten).
R2_ACCOUNT_ID=
# Nächtliche Sicherung: Token „Objekt nur lesen“, nur Bucket triskel-dateien
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Wiederherstellen in Prod (nur im Ernstfall, danach widerrufen), siehe README
# R2_RESTORE_ACCESS_KEY_ID=
# R2_RESTORE_SECRET_ACCESS_KEY=

# Stände der nächtlichen Sicherung vor Google Drive verschlüsseln (age, Review Teil B R-3; README ›
# Sichern › Verschlüsselung). `brew install age`, dann `age-keygen`: die Zeile „public key: age1…“
# hier als Empfänger, den privaten Schlüssel AGE-SECRET-KEY-1… hier UND im Passwort-Manager
# (ohne ihn ist kein Stand von Drive lesbar). Beide nur hier – .env.local ist aus Repo und
# Drive-Spiegel ausgeschlossen.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=

# Kein service_role key – weder hier noch sonst im Repo oder Client (CLAUDE.md, Regel 3).
